{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "snap-pixel",
  "version": 4,
  "name": "Snap Pixel",
  "provider": "Snap Inc.",
  "category": "marketing",
  "purpose": "Measures Snapchat ads.",
  "privacyUrl": "https://values.snap.com/privacy/privacy-policy",
  "dataCountry": "USA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "sc-static.net/scevent.min.js",
      "tr.snapchat.com"
    ],
    "inline": [
      "snaptr('init'",
      "snaptr(\"init\""
    ]
  },
  "cookies": [
    {
      "name": "_scid",
      "lifetime": "Up to 13 months",
      "purpose": "Tells visitors apart."
    },
    {
      "name": "_scid_r",
      "lifetime": "Up to 13 months",
      "purpose": "Ad measurement."
    }
  ],
  "storage": [
    "u_sclid",
    "u_sclid_r",
    "u_scsid",
    "_scsrid",
    "_scsrid_r"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "snapchat-for-woocommerce/snapchat-for-woocommerce.php"
    ],
    "handles": [
      "snapchat_tracking"
    ]
  },
  "sources": [
    "https://values.snap.com/privacy/privacy-policy",
    "https://values.snap.com/privacy/privacy-policy/eea-uk-privacy-notice",
    "https://www.snap.com/cookie-policy",
    "https://developers.snap.com/api/marketing-api/Conversions-API/UsingTheAPI",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list",
    "https://sc-static.net/scevent.min.js",
    "https://wordpress.org/plugins/snapchat-for-woocommerce/",
    "https://plugins.svn.wordpress.org/snapchat-for-woocommerce/trunk/snapchat-for-woocommerce.php",
    "https://plugins.svn.wordpress.org/snapchat-for-woocommerce/tags/1.0.8/includes/Assets.php",
    "https://plugins.svn.wordpress.org/snapchat-for-woocommerce/tags/1.0.8/js/build/tracking.js"
  ],
  "checked": "2026-11-10"
}
