{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "activecampaign",
  "version": 4,
  "name": "ActiveCampaign",
  "provider": "ActiveCampaign, LLC",
  "category": "marketing",
  "purpose": "Tracks visits for email marketing.",
  "privacyUrl": "https://www.activecampaign.com/legal/privacy-policy",
  "dataCountry": "USA, EU or Australia by account; other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "diffuser-cdn.app-us1.com",
      "prism.app-us1.com",
      "trackcmp.net"
    ],
    "inline": [
      "vgo('setAccount'",
      "vgo(\"setAccount\""
    ]
  },
  "cookies": [
    {
      "name": "prism_*",
      "lifetime": "30 days",
      "purpose": "Tells visitors apart."
    },
    {
      "name": "ac_enable_tracking",
      "lifetime": "30 days",
      "purpose": "Records that tracking is on."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "activecampaign-for-woocommerce/activecampaign-for-woocommerce.php",
      "activecampaign-subscription-forms/activecampaign.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.activecampaign.com/legal/privacy-policy",
    "https://wordpress.org/plugins/activecampaign-for-woocommerce/",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list",
    "https://help.activecampaign.com/hc/en-us/articles/12883541905436-ActiveCampaign-data-hosting-locations",
    "https://www.activecampaign.com/legal/mrdc-policy",
    "https://diffuser-cdn.app-us1.com/diffuser/diffuser.js",
    "https://plugins.svn.wordpress.org/activecampaign-for-woocommerce/tags/3.1.0/public/js/site_tracking.js",
    "https://wordpress.org/plugins/activecampaign-subscription-forms/",
    "https://plugins.svn.wordpress.org/activecampaign-subscription-forms/trunk/activecampaign.php"
  ],
  "checked": "2026-11-10"
}
