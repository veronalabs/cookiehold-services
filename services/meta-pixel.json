{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "meta-pixel",
  "version": 6,
  "name": "Meta Pixel",
  "provider": "Meta Platforms Ireland Limited",
  "category": "marketing",
  "purpose": "Measures Facebook and Instagram ads.",
  "privacyUrl": "https://www.facebook.com/privacy/policy/",
  "dataCountry": "USA (EU-US Data Privacy Framework)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "connect.facebook.net",
      "facebook.com/tr"
    ],
    "inline": [
      "connect.facebook.net",
      "fbq('init'",
      "fbq(\"init\"",
      "fbq('track",
      "fbq(\"track"
    ]
  },
  "cookies": [
    {
      "name": "_fbp",
      "lifetime": "90 days",
      "purpose": "Ad measurement."
    },
    {
      "name": "_fbc",
      "lifetime": "90 days",
      "purpose": "Stores the ad click."
    },
    {
      "name": "fr",
      "lifetime": "90 days",
      "purpose": "Ad delivery.",
      "httpOnly": true
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "pixelyoursite/facebook-pixel-master.php",
      "pixelyoursite-pro/pixelyoursite-pro.php",
      "official-facebook-pixel/facebook-for-wordpress.php",
      "facebook-for-woocommerce/facebook-for-woocommerce.php",
      "facebook-conversion-pixel/facebook-conversion-pixel.php"
    ],
    "handles": [
      "wc-facebook-pixel-events",
      "facebook-capi-param-builder"
    ]
  },
  "sources": [
    "https://www.facebook.com/privacy/policies/cookies/",
    "https://www.facebook.com/privacy/policies/data_privacy_framework/",
    "https://www.facebook.com/privacy/policy/",
    "https://www.facebook.com/legal/terms/businesstools",
    "https://developers.facebook.com/docs/marketing-api/conversions-api/parameters/fbp-and-fbc",
    "https://wordpress.org/plugins/pixelyoursite/",
    "https://wordpress.org/plugins/official-facebook-pixel/",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/facebook-for-woocommerce/trunk/facebook-for-woocommerce.php",
    "https://developers.facebook.com/docs/meta-pixel/implementation/conversion-tracking/",
    "https://plugins.svn.wordpress.org/pixelyoursite/trunk/facebook-pixel-master.php",
    "https://wordpress.org/plugins/facebook-conversion-pixel/",
    "https://plugins.svn.wordpress.org/facebook-conversion-pixel/trunk/facebook-conversion-pixel.php"
  ],
  "checked": "2026-11-10"
}
