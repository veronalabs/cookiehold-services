{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "stripe",
  "version": 4,
  "name": "Stripe",
  "provider": "Stripe Payments Europe, Limited",
  "category": "essential",
  "purpose": "Processes card payments and prevents fraud.",
  "privacyUrl": "https://stripe.com/privacy",
  "dataCountry": "USA, India and other countries",
  "legalBasis": "contract",
  "match": {
    "hosts": [
      "js.stripe.com",
      "m.stripe.network",
      "m.stripe.com",
      "q.stripe.com",
      "b.stripecdn.com"
    ]
  },
  "cookies": [
    {
      "name": "__stripe_mid",
      "lifetime": "1 year",
      "purpose": "Fraud prevention."
    },
    {
      "name": "__stripe_sid",
      "lifetime": "30 minutes",
      "purpose": "Fraud prevention."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "woocommerce-gateway-stripe/woocommerce-gateway-stripe.php",
      "woo-stripe-payment/stripe-payments.php",
      "stripe-payments/accept-stripe-payments.php",
      "funnelkit-stripe-woo-payment-gateway/funnelkit-stripe-woo-payment-gateway.php",
      "easy-paypal-donation/easy-paypal-donation.php",
      "wp-ecommerce-paypal/wp-ecommerce-paypal.php"
    ],
    "handles": []
  },
  "sources": [
    "https://stripe.com/privacy",
    "https://stripe.com/se/legal/privacy-center",
    "https://stripe.com/se/legal/cookies-policy",
    "https://docs.stripe.com/security/guide",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://wordpress.org/plugins/woocommerce-gateway-stripe/",
    "https://www.dataprivacyframework.gov/list",
    "https://stripe.com/cookie-settings",
    "https://docs.stripe.com/ips",
    "https://docs.stripe.com/disputes/prevention/advanced-fraud-detection",
    "https://plugins.svn.wordpress.org/woocommerce-gateway-stripe/trunk/woocommerce-gateway-stripe.php",
    "https://wordpress.org/plugins/woo-stripe-payment/",
    "https://plugins.svn.wordpress.org/woo-stripe-payment/trunk/stripe-payments.php",
    "https://wordpress.org/plugins/stripe-payments/",
    "https://plugins.svn.wordpress.org/stripe-payments/trunk/accept-stripe-payments.php",
    "https://wordpress.org/plugins/funnelkit-stripe-woo-payment-gateway/",
    "https://plugins.svn.wordpress.org/funnelkit-stripe-woo-payment-gateway/trunk/funnelkit-stripe-woo-payment-gateway.php",
    "https://wordpress.org/plugins/easy-paypal-donation/",
    "https://plugins.svn.wordpress.org/easy-paypal-donation/trunk/easy-paypal-donation.php",
    "https://wordpress.org/plugins/wp-ecommerce-paypal/",
    "https://plugins.svn.wordpress.org/wp-ecommerce-paypal/trunk/wp-ecommerce-paypal.php"
  ],
  "checked": "2026-11-10"
}
