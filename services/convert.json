{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "convert",
  "version": 1,
  "name": "Convert Experiences",
  "provider": "Convert Insights, Inc.",
  "category": "statistics",
  "purpose": "Runs A/B tests and measures their results.",
  "privacyUrl": "https://www.convert.com/privacy-notice/",
  "dataCountry": "EU (Germany)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "cdn-4.convertexperiments.com",
      "cdn-3.convertexperiments.com"
    ],
    "inline": [
      "_conv_q",
      "_conv_prevent_bodyhide"
    ]
  },
  "cookies": [
    {
      "name": "_conv_v",
      "lifetime": "6 months",
      "purpose": "Remembers visits, test versions and goals."
    },
    {
      "name": "_conv_s",
      "lifetime": "20 minutes",
      "purpose": "Keeps the current visit and page count."
    },
    {
      "name": "_conv_r",
      "lifetime": "180 days",
      "purpose": "Remembers how the visitor reached the site."
    },
    {
      "name": "_conv_sptest",
      "lifetime": "15 seconds",
      "purpose": "Carries the test version across a redirect."
    },
    {
      "name": "_conv_check_cookies",
      "lifetime": "Immediately deleted",
      "purpose": "Checks whether the browser accepts cookies."
    },
    {
      "name": "_conv_t",
      "lifetime": "1 day",
      "purpose": "Keeps a debug token for test previews."
    },
    {
      "name": "convert_optout",
      "lifetime": "5 years",
      "purpose": "Remembers the choice to opt out of testing."
    }
  ],
  "storage": [
    "convert.com",
    "convertLoadVisualEditor",
    "convert_config",
    "convert_debug_token"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "convert-experiments/convert-experiments.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.convert.com/privacy-notice/",
    "https://www.convert.com/trusted-performance/",
    "https://support.convert.com/hc/en-us/articles/204495429-Convert-Experiences-Tracking-Cookies-Structure",
    "https://support.convert.com/hc/en-us/articles/360028491292-Loading-the-Convert-tracking-code-async-while-preventing-flashing",
    "https://support.convert.com/hc/en-us/articles/205151115-run-convert-experiences-on-cloudflare",
    "https://support.convert.com/hc/en-us/articles/115000009031-how-to-track-revenue-using-gtm",
    "https://support.convert.com/hc/en-us/articles/114094130151-Disable-AB-testing",
    "https://support.convert.com/hc/en-us/articles/custom-domains-cloudflare-for-the-convert-tracking-script",
    "https://cdn-4.convertexperiments.com/v1/js/1-4.js",
    "https://partners.convert.com/partner/wordpress",
    "https://wordpress.org/plugins/convert-experiments/",
    "https://plugins.svn.wordpress.org/convert-experiments/trunk/convert-experiments.php",
    "https://plugins.svn.wordpress.org/convert-experiments/trunk/classes/frontend/class-convert-script.php",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-10"
}
