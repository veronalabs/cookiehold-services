{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "hello-bar",
  "version": 1,
  "name": "Hello Bar",
  "provider": "Hello Bar LLC",
  "category": "marketing",
  "purpose": "Shows promotional bars and pop-ups.",
  "privacyUrl": "https://www.hellobar.com/privacy-policy/",
  "dataCountry": "",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "my.hellobar.com",
      "hi.hellobar.com"
    ]
  },
  "cookies": [],
  "storage": [
    "hbv_*",
    "hbs_*",
    "hb_form_session_id",
    "_hb_gam_*",
    "_hbs_session_started_at"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "hellobar/hellobar.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.hellobar.com/privacy-policy/",
    "https://www.hellobar.com/gdpr/",
    "https://www.hellobar.com/",
    "https://support.hellobar.com/support/solutions/articles/44001406999-how-to-install-hello-bar-on-wordpress",
    "https://support.hellobar.com/support/solutions/articles/44001406936-how-to-install-hello-bar-using-google-tag-manager-gtm-",
    "https://my.hellobar.com/ad8830587daad80ceb0c6a89aba650cdda1e5f8c.js",
    "https://my.hellobar.com/modules-v2.js",
    "https://my.hellobar.com/modules-v26.js",
    "https://wordpress.org/plugins/hellobar/",
    "https://plugins.svn.wordpress.org/hellobar/trunk/",
    "https://plugins.svn.wordpress.org/hellobar/trunk/hellobar.php",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://raw.githubusercontent.com/jkwakman/Open-Cookie-Database/master/open-cookie-database.csv",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-10"
}
