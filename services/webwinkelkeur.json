{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "webwinkelkeur",
  "version": 1,
  "name": "WebwinkelKeur",
  "provider": "Stichting ValuedShops",
  "category": "media",
  "purpose": "Shows a trust seal and customer reviews.",
  "privacyUrl": "https://www.webwinkelkeur.nl/page/privacybeleid/",
  "dataCountry": "UK (England)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "dashboard.webwinkelkeur.nl",
      "www.webwinkelkeur.nl/js/sidebar.js",
      "www.webwinkelkeur.nl/apps/seoshop/scripts/sidebar_"
    ],
    "inline": [
      "https://dashboard.webwinkelkeur.nl",
      "_webwinkelkeur_id"
    ]
  },
  "cookies": [],
  "storage": [
    "wwkSidebarTopHidden",
    "webwinkelkeur_popup_shown_*"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "generic",
  "wordpress": {
    "plugins": [
      "webwinkelkeur/webwinkelkeur.php"
    ],
    "handles": []
  },
  "sources": [
