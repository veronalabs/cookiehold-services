    "https://docs.webwinkelkeur.nl/api/review-popup/",
    "https://docs.webwinkelkeur.nl/gtm/",
    "https://dashboard.webwinkelkeur.nl/sidebar.js?id=1",
    "https://dashboard.webwinkelkeur.nl/edge/sidebar/CgH9Sw11rNHm207dVIoi.js",
