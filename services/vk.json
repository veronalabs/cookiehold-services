    "https://vk.com/js/api/openapi.js?168",
    "https://vk.ru/js/api/share.js?95",
    "https://vk.com/js/api/share.js?95",
    "https://www.dataprivacyframework.gov/list",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://raw.githubusercontent.com/jkwakman/Open-Cookie-Database/master/open-cookie-database.csv",
    "https://wordpress.org/plugins/vkontakte/",
    "https://plugins.svn.wordpress.org/vkontakte/trunk/vkontakte.php",
    "https://wordpress.org/plugins/heateor-social-comments/",
