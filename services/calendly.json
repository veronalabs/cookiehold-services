{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "calendly",
  "version": 3,
  "name": "Calendly",
  "provider": "Calendly LLC",
  "category": "functional",
  "purpose": "Shows an embedded booking calendar.",
  "privacyUrl": "https://calendly.com/legal/privacy-notice",
  "dataCountry": "USA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "assets.calendly.com",
      "calendly.com/assets/"
    ],
    "frames": [
      "calendly.com"
    ],
    "inline": [
      "Calendly.initInlineWidget",
      "Calendly.initBadgeWidget"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "generic",
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://calendly.com/legal/privacy-notice",
    "https://calendly.com/help/cookies-and-your-calendly-experience",
    "https://www.dataprivacyframework.gov/list",
    "https://calendly.com/legal/data-processing-addendum",
    "https://calendly.com/help/calendly-sub-processors-gdpr-ccpa",
    "https://calendly.com/help/calendly-cookie-management-and-banner",
    "https://developer.calendly.com/api-docs/overview/embedding/getting-started"
  ],
  "checked": "2026-11-10"
}
