{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "matomo-cloud",
  "version": 4,
  "name": "Matomo Cloud",
  "provider": "InnoCraft Limited",
  "category": "statistics",
  "purpose": "Measures visits and conversions.",
  "privacyUrl": "https://matomo.org/matomo-cloud-privacy-policy/",
  "dataCountry": "EU (Germany, Ireland, Netherlands); optional CDN and AI worldwide",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "matomo.cloud",
      "innocraft.cloud"
    ],
    "inline": [
      "matomo.cloud"
    ]
  },
  "cookies": [
    {
      "name": "_pk_id.*",
      "lifetime": "13 months",
      "purpose": "Tells visitors apart."
    },
    {
      "name": "_pk_ses.*",
      "lifetime": "30 minutes",
      "purpose": "Keeps the current visit."
    },
    {
      "name": "_pk_ref.*",
      "lifetime": "6 months",
      "purpose": "Stores where the visitor came from."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://matomo.org/matomo-cloud-privacy-policy/",
    "https://matomo.org/faq/general/faq_146/",
    "https://matomo.org/matomo-cloud-dpa/subprocessors/",
    "https://matomo.org/faq/how-to/how-do-i-know-which-version-of-matomo-i-am-using/",
    "https://developer.matomo.org/guides/tracking-javascript-guide"
  ],
  "checked": "2026-11-16"
}
