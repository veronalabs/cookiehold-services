{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "reviews-io",
  "version": 1,
  "name": "REVIEWS.io",
  "provider": "REVIEWS.io Limited",
  "category": "media",
  "purpose": "Shows customer reviews and ratings.",
  "privacyUrl": "https://www.reviews.io/legal/user-privacy-policy",
  "dataCountry": "UK, EU, USA and Australia",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "widget.reviews.io",
      "widget.reviews.co.uk",
      "assets.reviews.io",
      "dash.reviews.co.uk/widget/"
    ],
    "inline": [
      "richSnippetReviewsWidgets(",
      "reviewsBadgeModern(",
      "ratingSnippet(\"ruk_rating_snippet\"",
      "new ReviewsWidget("
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "generic",
  "wordpress": {
    "plugins": [
      "reviewscouk-for-woocommerce/woocommerce-reviews.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.reviews.io/legal/user-privacy-policy",
    "https://www.reviews.io/front/third-party-processors",
    "https://www.reviews.io/legal/data-protection",
    "https://support.reviews.io/en/articles/9185031-widget-library",
    "https://support.reviews.io/en/articles/9184952-product-rich-snippets",
    "https://support.reviews.io/en/articles/9184879-multilingual-set-up-widget-translations",
    "https://support.reviews.io/en/articles/9185063-volusion-reviews-plugin",
    "https://support.reviews.io/en/articles/16150711-getting-started-woocommerce",
    "https://widget.reviews.io/product/dist.js",
    "https://widget.reviews.io/rating-snippet/dist.js",
    "https://widget.reviews.io/polaris/build.js",
    "https://widget.reviews.io/modern-widgets/floating.js",
    "https://widget.reviews.co.uk/rich-snippet-reviews-widgets/dist.js",
    "https://widget.reviews.co.uk/badge-modern/dist.js",
    "https://widget.reviews.co.uk/polaris/build.js",
    "https://dash.reviews.co.uk/widget/float.js",
    "https://en-gb.wordpress.org/plugins/reviewscouk-for-woocommerce/",
    "https://plugins.svn.wordpress.org/reviewscouk-for-woocommerce/trunk/",
    "https://plugins.svn.wordpress.org/reviewscouk-for-woocommerce/trunk/woocommerce-reviews.php",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-10"
}
