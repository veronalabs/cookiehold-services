{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "amazon-payment-services",
  "version": 1,
  "name": "Amazon Payment Services",
  "provider": "",
  "category": "essential",
  "purpose": "Processes online payments.",
  "privacyUrl": "https://paymentservices.amazon.com/privacy",
  "dataCountry": "",
  "legalBasis": "contract",
  "match": {
    "hosts": [
      "checkout.payfort.com",
      "sbcheckout.payfort.com"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "amazon-payment-services/woocommerce-aps.php"
    ],
    "handles": []
  },
  "sources": [
    "https://paymentservices.amazon.com/docs/api/accepting-payments/hosted-checkout",
    "https://paymentservices.amazon.com/docs/accepting-payments/no-code/Plugins/WooCommerce",
    "https://paymentservices.amazon.com/privacy",
    "https://paymentservices.amazon.com/cookies-notice",
    "https://plugins.svn.wordpress.org/amazon-payment-services/trunk/woocommerce-aps.php",
    "https://plugins.svn.wordpress.org/amazon-payment-services/trunk/public/js/aps-checkout.js",
    "https://plugins.svn.wordpress.org/amazon-payment-services/trunk/public/js/aps-main.js",
    "https://wordpress.org/plugins/amazon-payment-services/",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-14"
}
