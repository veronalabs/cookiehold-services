{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "callrail",
  "version": 1,
  "name": "CallRail",
  "provider": "CallRail, LLC",
  "category": "marketing",
  "purpose": "Tracks which marketing campaigns lead to calls.",
  "privacyUrl": "https://www.callrail.com/privacy",
  "dataCountry": "USA",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "cdn.callrail.com"
    ],
    "inline": [
      "cdn.callrail.com/companies/"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "callrail-phone-call-tracking/callrail.php"
    ],
    "handles": []
  },
  "sources": [
