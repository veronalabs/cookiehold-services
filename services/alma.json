    "https://docs.almapay.com/docs/integration-in-page.md",
    "https://docs.almapay.com/docs/custom-integration-alma-widget",
    "https://docs.almapay.com/docs/custom-integration-alma-widget.md",
    "https://cdn.jsdelivr.net/npm/@alma/in-page@2.x/dist/index.umd.js",
    "https://cdn.jsdelivr.net/npm/@alma/widgets@4.x/dist/widgets.umd.js",
    "https://wordpress.org/plugins/alma-gateway-for-woocommerce/",
    "https://plugins.svn.wordpress.org/alma-gateway-for-woocommerce/trunk/",
    "https://plugins.svn.wordpress.org/alma-gateway-for-woocommerce/trunk/alma-gateway-for-woocommerce.php",
    "https://plugins.svn.wordpress.org/alma-gateway-for-woocommerce/trunk/includes/Infrastructure/Config/AssetsConfig.php",
