  "id": "alma",
  "version": 1,
  "name": "Alma",
  "provider": "Alma SAS",
  "category": "essential",
  "purpose": "Offers instalment and deferred payments.",
  "privacyUrl": "https://almapay.com/legal/privacy-policy",
  "dataCountry": "",
  "legalBasis": "contract",
  "match": {
    "hosts": [
      "cdn.jsdelivr.net/npm/@alma/in-page@",
      "cdn.jsdelivr.net/npm/@alma/widgets@",
      "checkout.getalma.eu",
      "checkout.sandbox.getalma.eu",
      "checkout.almapay.com",
      "checkout.sandbox.almapay.com",
      "cdn.almapay.com/fonts/Inter/"
