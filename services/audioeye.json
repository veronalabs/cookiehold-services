{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "audioeye",
  "version": 1,
  "name": "AudioEye",
  "provider": "AudioEye, Inc.",
  "category": "functional",
  "purpose": "Adds website accessibility features.",
  "privacyUrl": "https://www.audioeye.com/privacy-policy/",
  "dataCountry": "USA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "wsv3cdn.audioeye-services.com",
      "wsmcdn.audioeye.com",
      "wsv3cdn.audioeye.com"
    ],
    "inline": [
      "__AudioEyeSiteHash"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "accessibility-by-audioeye/audioeye.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.audioeye.com/privacy-policy/",
    "https://help.audioeye.com/install-audioeye-directly-to-your-website",
    "https://help.audioeye.com/install-audioeye-on-a-wordpress-site",
    "https://help.audioeye.com/audioeye-and-cookie-blocking-tools",
    "https://www.audioeye.com/post/domain-change-update/",
    "https://wsv3cdn.audioeye-services.com/aem.js",
    "https://wsmcdn.audioeye.com/aem.js",
    "https://wordpress.org/plugins/accessibility-by-audioeye/",
    "https://plugins.svn.wordpress.org/accessibility-by-audioeye/trunk/",
    "https://plugins.svn.wordpress.org/accessibility-by-audioeye/trunk/audioeye.php",
    "https://plugins.svn.wordpress.org/accessibility-by-audioeye/trunk/public/class-audioeye-public.php",
    "https://plugins.svn.wordpress.org/accessibility-by-audioeye/trunk/includes/audioeye-functions.php",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-10"
}
