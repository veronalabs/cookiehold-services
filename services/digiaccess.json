{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "digiaccess",
  "version": 1,
  "name": "digi·access",
  "provider": "digi·access GmbH",
  "category": "functional",
  "purpose": "Adds accessibility tools to the page.",
  "privacyUrl": "https://www.digiaccess.org/datenschutz/",
  "dataCountry": "EU (Germany)",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "download.digiaccess.org"
    ]
  },
  "cookies": [],
  "storage": [
    "da-TTS",
    "da-adhd-profile",
    "da-alignment",
    "da-animationToggle",
    "da-ariaLabels",
    "da-background-color",
    "da-backgroundColor",
    "da-big-cursor",
    "da-bigMouseData",
    "da-black-white",
    "da-blackNWhite",
    "da-character-spacing",
    "da-characterSpacing",
    "da-cognitive-restrictions-profile",
    "da-content-size",
    "da-contrast",
    "da-currentStep",
    "da-digispeechData",
    "da-epileptic-profile",
    "da-extended-adjustment",
    "da-fix-*",
    "da-font-size",
    "da-fontColor",
    "da-fontSize",
    "da-headerColor",
    "da-hide-images",
    "da-hide-widget",
    "da-imageToggle",
    "da-individual-content",
    "da-keyboardNavigation",
    "da-language",
    "da-lastActiveIndexData",
    "da-layoutColor",
    "da-light-strip",
    "da-lightStripData",
    "da-line-height",
    "da-lineHeight",
    "da-link-color",
    "da-link-highlight",
    "da-linkColor",
    "da-linkHighlighting",
    "da-mouse-hover",
    "da-mouseHover",
    "da-mute-sound",
    "da-navigation",
    "da-profilePresets",
    "da-refresh-widget",
    "da-reverseColors",
    "da-saturation",
    "da-screen-reader-adjustments",
    "da-simple-font",
    "da-simpleFont",
    "da-soundToggle",
    "da-stop-animations",
    "da-stop-video",
    "da-text-color",
    "da-text-magnify",
    "da-textHighlight",
    "da-title-color",
    "da-videoToggle",
    "da-virtual-keyboard",
    "da-virtualKeyboard",
    "da-visual-impairment-profile",
    "da-word-spacing",
    "da-wordSpacing",
    "da-zoom"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [],
    "handles": []
  },
  "sources": [
    "https://www.digiaccess.org/",
    "https://www.digiaccess.org/datenschutz/",
    "https://www.digiaccess.org/faq/",
    "https://www.digiaccess.org/blog/wordpress-implementierung/",
    "https://www.digiaccess.org/blog/typo3-implementierung/",
    "https://www.digiaccess.org/wp-content/uploads/2024/10/Bildschirmfoto-2020-07-16-um-12.14.17-1536x581-1-1024x387.png",
    "https://download.digiaccess.org/digiaccess",
    "https://download.digiaccess.org/digiaccess/tool?lang=de",
    "https://www.digiaccess.org/datenschutzerklaerung/",
    "https://api.wordpress.org/plugins/info/1.2/?action=query_plugins&request%5Bsearch%5D=digiaccess&request%5Bper_page%5D=10",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-16"
}
