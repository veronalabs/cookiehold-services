{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "cloudflare-turnstile",
  "version": 4,
  "name": "Cloudflare Turnstile",
  "provider": "Cloudflare, Inc.",
  "category": "essential",
  "purpose": "Keeps spam out of forms. It sets no tracking cookies and is used only for security.",
  "privacyUrl": "https://www.cloudflare.com/turnstile-privacy-policy/",
  "dataCountry": "USA, EEA and other countries",
  "legalBasis": "legitimate-interest",
  "match": {
    "hosts": [
      "challenges.cloudflare.com/turnstile"
    ]
  },
  "cookies": [],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "simple-cloudflare-turnstile/simple-cloudflare-turnstile.php",
      "enable-turnstile-cloudflare-for-gravity-forms/ss88-gravity-forms-turnstile.php",
      "wppool-turnstile-captcha-spam-filter/easy-cloudflare-turnstile.php",
      "login-security-recaptcha/login-security-recaptcha.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.cloudflare.com/privacypolicy/",
    "https://developers.cloudflare.com/turnstile/",
    "https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/",
    "https://wordpress.org/plugins/simple-cloudflare-turnstile/",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/simple-cloudflare-turnstile/trunk/",
    "https://plugins.svn.wordpress.org/enable-turnstile-cloudflare-for-gravity-forms/trunk/",
    "https://plugins.svn.wordpress.org/wppool-turnstile-captcha-spam-filter/trunk/",
    "https://www.cloudflare.com/turnstile-privacy-policy/",
    "https://developers.cloudflare.com/turnstile/get-started/server-side-validation/",
    "https://developers.cloudflare.com/turnstile/additional-configuration/hostname-management/pre-clearance/",
    "https://wordpress.org/plugins/login-security-recaptcha/",
    "https://plugins.svn.wordpress.org/login-security-recaptcha/trunk/login-security-recaptcha.php"
  ],
  "checked": "2026-11-10"
}
