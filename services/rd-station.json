{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "rd-station",
  "version": 1,
  "name": "RD Station Marketing",
  "provider": "RD Gestão e Sistemas S.A",
  "category": "marketing",
  "purpose": "Tracks visits for automated marketing.",
  "privacyUrl": "https://legal.rdstation.com/pt/privacy-policy/",
  "dataCountry": "USA",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "d335luupugsy2.cloudfront.net",
      "d1sag09wwfbul8.cloudfront.net/rdtracker/"
    ]
  },
  "cookies": [
    {
      "name": "rdtrk",
      "lifetime": "1 year",
      "purpose": "Links page visits to a marketing lead."
    },
    {
      "name": "__trf.src",
      "lifetime": "1 year",
      "purpose": "Remembers how the visitor reached the site."
    }
  ],
  "storage": [
    "rdtracker:identity",
    "rdtracker:token"
  ],
  "consentMode": {
