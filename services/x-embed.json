{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "x-embed",
  "version": 4,
  "name": "X (Twitter) embeds",
  "provider": "X Internet Unlimited Company",
  "category": "media",
  "purpose": "Shows embedded posts and timelines.",
  "privacyUrl": "https://x.com/en/privacy",
  "dataCountry": "USA and other countries",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "platform.twitter.com",
      "syndication.twitter.com",
      "cdn.syndication.twimg.com",
      "pbs.twimg.com"
    ]
  },
  "cookies": [
    {
      "name": "guest_id",
      "lifetime": "2 years",
      "purpose": "Tells visitors apart."
    },
    {
      "name": "personalization_id",
      "lifetime": "2 years",
      "purpose": "Personalises content and ads."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "social",
  "wordpress": {
    "plugins": [
      "custom-twitter-feeds/custom-twitter-feed.php",
      "easy-twitter-feed-widget/easy-twitter-feed-widget.php"
    ],
    "handles": []
  },
  "sources": [
    "https://x.com/en/privacy",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/custom-twitter-feeds/trunk/custom-twitter-feed.php",
    "https://help.x.com/en/rules-and-policies/x-cookies",
    "https://help.x.com/en/x-for-websites-ads-info-and-privacy",
    "https://platform.twitter.com/widgets.js",
    "https://wordpress.org/plugins/easy-twitter-feed-widget/",
    "https://plugins.svn.wordpress.org/easy-twitter-feed-widget/trunk/easy-twitter-feed-widget.php"
  ],
  "checked": "2026-11-10"
}
