{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "youtube",
  "version": 6,
  "name": "YouTube",
  "provider": "Google Ireland Limited",
  "category": "media",
  "purpose": "Shows embedded videos.",
  "privacyUrl": "https://policies.google.com/privacy",
  "dataCountry": "Worldwide",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "youtube.com/embed",
      "youtube-nocookie.com/embed",
      "youtube.com/iframe_api",
      "youtube.com/s/player",
      "youtube.com/watch",
      "youtu.be",
      "youtube.com/player_api"
    ]
  },
  "cookies": [
    {
      "name": "YSC",
      "lifetime": "Session",
      "purpose": "Checks that requests come from the visitor."
    },
    {
      "name": "VISITOR_INFO1_LIVE",
      "lifetime": "6 months",
      "purpose": "Video recommendations and statistics."
    },
    {
      "name": "__Secure-YNID",
      "lifetime": "6 months",
      "purpose": "Video preferences and statistics."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "video",
  "wordpress": {
    "plugins": [
      "feeds-for-youtube/youtube-feed.php",
      "wp-social-reviews/wp-social-reviews.php",
      "youtube-embed-plus/youtube.php",
      "wp-youtube-lyte/wp-youtube-lyte.php"
    ],
    "handles": []
  },
  "sources": [
    "https://policies.google.com/technologies/cookies",
    "https://business.safety.google/adscookies/",
    "https://policies.google.com/privacy/frameworks",
    "https://policies.google.com/privacy",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/feeds-for-youtube/trunk/youtube-feed.php",
    "https://plugins.svn.wordpress.org/wp-social-reviews/trunk/wp-social-reviews.php",
    "https://support.google.com/youtube/answer/171780?hl=en",
    "https://developers.google.com/youtube/iframe_api_reference",
    "https://developers.google.com/youtube/terms/developer-policies",
    "https://policies.google.com/faq?hl=en",
    "https://developers.google.com/youtube/player_parameters",
    "https://support.google.com/youtube/answer/7174035?hl=en",
    "https://wordpress.org/plugins/youtube-embed-plus/",
    "https://plugins.svn.wordpress.org/youtube-embed-plus/trunk/youtube.php",
    "https://wordpress.org/plugins/wp-youtube-lyte/",
    "https://plugins.svn.wordpress.org/wp-youtube-lyte/trunk/wp-youtube-lyte.php"
  ],
  "checked": "2026-11-10"
}
