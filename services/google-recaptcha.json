{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "google-recaptcha",
  "version": 5,
  "name": "Google reCAPTCHA",
  "provider": "Google Cloud EMEA Limited or regional Google Cloud entity (depends on customer country)",
  "category": "functional",
  "purpose": "Keeps spam out of forms.",
  "privacyUrl": "https://cloud.google.com/terms/data-processing-addendum",
  "dataCountry": "Worldwide",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "google.com/recaptcha",
      "recaptcha.net",
      "gstatic.com/recaptcha"
    ]
  },
  "cookies": [
    {
      "name": "_GRECAPTCHA",
      "lifetime": "6 months",
      "purpose": "Spam protection."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "form",
  "wordpress": {
    "plugins": [
      "contact-form-7/wp-contact-form-7.php",
      "advanced-google-recaptcha/advanced-google-recaptcha.php",
      "google-captcha/google-captcha.php",
      "wpcf7-recaptcha/wpcf7-recaptcha.php",
      "contact-form-7-simple-recaptcha/contact-form-7-simple-recaptcha.php",
      "advanced-nocaptcha-recaptcha/advanced-nocaptcha-recaptcha.php",
      "invisible-recaptcha/invisible-recaptcha.php",
      "login-recaptcha/login-nocaptcha.php",
      "recaptcha-woo/recaptcha-woo.php",
      "um-recaptcha/um-recaptcha.php",
      "recaptcha-for-mw-wp-form/recaptcha-for-mw-wp-form.php",
      "login-security-recaptcha/login-security-recaptcha.php",
      "gravity-forms-no-captcha-recaptcha/gf-no-captcha-recaptcha.php"
    ],
    "handles": [
      "wpcf7-recaptcha",
      "gglcptch_script",
      "um-recaptcha"
    ]
  },
  "sources": [
    "https://developers.google.com/recaptcha/docs/faq",
    "https://policies.google.com/privacy/frameworks",
    "https://policies.google.com/privacy",
    "https://github.com/jkwakman/Open-Cookie-Database",
    "https://www.dataprivacyframework.gov/list",
    "https://plugins.svn.wordpress.org/contact-form-7/trunk/",
    "https://plugins.svn.wordpress.org/google-captcha/trunk/",
    "https://plugins.svn.wordpress.org/um-recaptcha/trunk/",
    "https://plugins.svn.wordpress.org/advanced-google-recaptcha/trunk/",
    "https://plugins.svn.wordpress.org/wpcf7-recaptcha/trunk/",
    "https://plugins.svn.wordpress.org/contact-form-7-simple-recaptcha/trunk/",
    "https://plugins.svn.wordpress.org/advanced-nocaptcha-recaptcha/trunk/",
    "https://plugins.svn.wordpress.org/invisible-recaptcha/trunk/",
    "https://plugins.svn.wordpress.org/login-recaptcha/trunk/",
    "https://plugins.svn.wordpress.org/recaptcha-woo/trunk/",
    "https://docs.cloud.google.com/recaptcha/docs/faq",
    "https://cloud.google.com/terms/data-processing-addendum",
    "https://cloud.google.com/terms/google-entity",
    "https://cloud.google.com/terms/service-terms",
    "https://wordpress.org/plugins/recaptcha-for-mw-wp-form/",
    "https://plugins.svn.wordpress.org/recaptcha-for-mw-wp-form/trunk/recaptcha-for-mw-wp-form.php",
    "https://wordpress.org/plugins/login-security-recaptcha/",
    "https://plugins.svn.wordpress.org/login-security-recaptcha/trunk/login-security-recaptcha.php",
    "https://wordpress.org/plugins/gravity-forms-no-captcha-recaptcha/",
    "https://plugins.svn.wordpress.org/gravity-forms-no-captcha-recaptcha/trunk/gf-no-captcha-recaptcha.php"
  ],
  "checked": "2026-11-10"
}
