{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "simplybook",
  "version": 1,
  "name": "SimplyBook.me",
  "provider": "SimplyBook.me Ltd",
  "category": "functional",
  "purpose": "Shows an embedded booking calendar.",
  "privacyUrl": "https://simplybook.me/en/policy",
  "dataCountry": "EU for EU businesses; Canada, France, Singapore; USA via subprocessors",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "simplybook.me/v2/widget/",
      "simplybook.it/v2/widget/"
    ],
    "frames": [
      "simplybook.me/v2/",
      "simplybook.it/v2/",
      "simplybook.asia/v2/",
      "bookingsystem.nu/v2/",
      "simplybooking.io/v2/",
      "simplybook.vip/v2/",
      "simplybook.cc/v2/",
      "simplybook.us/v2/",
      "simplybook.pro/v2/",
      "enterpriseappointments.com/v2/",
      "simplybook.webnode.page/v2/",
      "servicebookings.net/v2/",
      "booking.names.uk/v2/",
      "booking.lcn.uk/v2/",
      "booking.register365.ie/v2/"
    ],
    "inline": [
      "new SimplybookWidget("
    ]
  },
  "cookies": [
    {
      "name": "sb_widget",
      "lifetime": "Session",
      "purpose": "Marks use of the booking widget."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": "generic",
  "wordpress": {
    "plugins": [
      "simplybook/simplybook.php"
    ],
    "handles": []
  },
  "sources": [
    "https://help.simplybook.me/wiki/Widgets_for_your_own_website",
    "https://simplybook.me/v2/widget/widget.js",
    "https://simplybook.me/en/policy",
    "https://simplybook.me/en/legal/dpa",
    "https://simplybook.me/en/legal/cookie_policy",
    "https://help.simplybook.me/index.php?title=Smart_Widget_custom_feature/en",
    "https://wordpress.org/plugins/simplybook/",
    "https://plugins.svn.wordpress.org/simplybook/trunk/simplybook.php",
    "https://plugins.svn.wordpress.org/simplybook/trunk/config/env.php",
    "https://plugins.svn.wordpress.org/simplybook/trunk/app/Support/Builders/WidgetScriptBuilder.php",
    "https://downloads.wordpress.org/plugin/simplybook.latest-stable.zip",
    "https://www.dataprivacyframework.gov/list"
  ],
  "checked": "2026-11-10"
}
