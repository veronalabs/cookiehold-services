{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "calameo",
  "version": 1,
  "name": "Calaméo",
  "provider": "Calaméo SAS",
  "category": "media",
  "purpose": "Shows embedded digital publications.",
