    "https://v.calameo.com/9705-000187/pinwheel/viewer/scripts/modules/desktop/viewer-desktop.js",
    "https://v.calameo.com/9705-000187/pinwheel/viewer/scripts/modules/mobile/viewer-mobile.js",
    "https://www.calameo.com/",
    "https://www.calameo.com/en/press",
    "https://wordpress.org/plugins/wp-calameo/",
    "https://plugins.svn.wordpress.org/wp-calameo/trunk/",
    "https://plugins.svn.wordpress.org/wp-calameo/trunk/wp-calameo.php",
    "https://www.dataprivacyframework.gov/list"
