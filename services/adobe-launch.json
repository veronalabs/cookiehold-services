{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "adobe-launch",
  "version": 1,
  "name": "Adobe Experience Platform Tags",
  "provider": "Adobe Systems Software Ireland Limited",
  "category": "essential",
  "purpose": "Loads the site's other tags.",
  "privacyUrl": "https://www.adobe.com/privacy/policy.html",
  "dataCountry": "Worldwide, including USA (EU-US Data Privacy Framework)",
  "legalBasis": "legitimate-interest",
  "match": {
    "hosts": [
      "assets.adobedtm.com"
