    "https://experienceleague.adobe.com/en/docs/experience-platform/tags/publish/environments/environments",
    "https://www.adobe.com/privacy/policy.html",
    "https://www.adobe.com/privacy/eudatatransfers.html",
    "https://www.adobe.com/privacy/experience-cloud.html",
    "https://assets.adobedtm.com/launch-EN93497c30fdf0424eb678d5f4ffac66dc.min.js",
    "https://assets.adobedtm.com/launch-EN93497c30fdf0424eb678d5f4ffac66dc.js",
