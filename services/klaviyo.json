{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "klaviyo",
  "version": 4,
  "name": "Klaviyo",
  "provider": "Klaviyo, Inc.",
  "category": "marketing",
  "purpose": "Tracks visits for email marketing.",
  "privacyUrl": "https://privacy.klaviyo.com/policies/?name=klaviyo-privacy-policy",
  "dataCountry": "USA; other countries for support and optional features",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "klaviyo.com"
    ],
    "inline": [
      "_learnq",
      "klaviyo.push("
    ]
  },
  "cookies": [
    {
      "name": "__kla_id",
      "lifetime": "2 years",
      "purpose": "Tells visitors apart."
    }
  ],
  "storage": [],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "klaviyo/klaviyo.php"
    ],
    "handles": [
      "kl-identify-browser",
      "wck_viewed_product",
      "wck_started_checkout"
    ]
  },
  "sources": [
    "https://privacy.klaviyo.com/policies/?name=klaviyo-privacy-policy",
    "https://www.klaviyo.com/gdpr",
    "https://help.klaviyo.com/hc/en-us/articles/360034666712",
    "https://wordpress.org/plugins/klaviyo/",
    "https://www.dataprivacyframework.gov/list",
    "https://www.klaviyo.com/legal/privacy-faqs",
    "https://trust.klaviyo.com/",
    "https://plugins.svn.wordpress.org/klaviyo/trunk/inc/kla-analytics.php"
  ],
  "checked": "2026-11-10"
}
