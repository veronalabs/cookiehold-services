{
  "$schema": "https://cdn.jsdelivr.net/gh/veronalabs/cookiehold-services@1/schema/service.json",
  "id": "zendesk-chat",
  "version": 4,
  "name": "Zendesk Chat",
  "provider": "Zendesk, Inc.",
  "category": "functional",
  "purpose": "Live chat and support messages.",
  "privacyUrl": "https://www.zendesk.com/company/agreements-and-terms/privacy-notice/",
  "dataCountry": "USA, EEA, UK, Japan or Australia by account; feature-specific exceptions",
  "legalBasis": "consent",
  "match": {
    "hosts": [
      "static.zdassets.com",
      "ekr.zdassets.com",
      "zopim.com"
    ],
    "inline": [
      "zESettings",
      "$zopim"
    ]
  },
  "cookies": [
    {
      "name": "__zlcmid",
      "lifetime": "1 year",
      "purpose": "Identifies the chat visitor."
    },
    {
      "name": "__zlcprivacy",
      "lifetime": "1 year",
      "purpose": "Remembers the visitor's cookie choice for chat."
    },
    {
      "name": "zte2095",
      "lifetime": "Session",
      "purpose": "Identifies the site that hosts the chat widget."
    }
  ],
  "storage": [
    "ZD-*",
    "__zlcstore"
  ],
  "consentMode": {
    "google": false,
    "advanced": false
  },
  "placeholder": null,
  "wordpress": {
    "plugins": [
      "zopim-live-chat/zopim.php"
    ],
    "handles": []
  },
  "sources": [
    "https://www.zendesk.com/company/agreements-and-terms/privacy-notice/",
    "https://support.zendesk.com/hc/en-us/articles/4408824378650-Zendesk-In-Product-Cookie-Policy",
    "https://www.dataprivacyframework.gov/list",
    "https://support.zendesk.com/hc/en-us/articles/4408883599130-Regional-Data-Hosting-Policy",
    "https://wordpress.org/plugins/zopim-live-chat/",
    "https://plugins.svn.wordpress.org/zopim-live-chat/trunk/zopim.php"
  ],
  "checked": "2026-11-10"
}
